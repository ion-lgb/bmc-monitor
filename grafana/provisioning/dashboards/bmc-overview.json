      "targets": [
        {
          "expr": "avg(sum by(instance)(ipmi_power_watts{name=~\"(?i)psu._pout\"}) / sum by(instance)(ipmi_power_watts{name=~\"(?i)psu._pin\"}))",
          "refId": "A"
        }
      ]
