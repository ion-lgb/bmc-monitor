      "fieldConfig": {
        "defaults": {
          "unit": "prefix:¥",
          "decimals": 2,
          "noValue": "无功耗数据",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(ipmi_dcmi_power_consumption_watts[$__range])) * $scrape_s / 3600 / 1000 * $price",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "碳排放",
      "description": "耗电量 × 电网排放因子。默认 0.5703 kgCO₂/kWh(中国全国电网平均值),可在顶部输入框改成你所在区域的因子。按「逐样本积分」计算,只统计真实采到数据的时间。\n删掉某台服务器后,它的历史数据会被清空,这里的数值也会相应减少,其他机器不受影响。\n注:部分机型的 BMC 不支持 DCMI 功耗读数,这类机器无法计入。",
      "datasource": null,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 17,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "noValue": "无功耗数据",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "suffix: kg"
        },
        "overrides": [],
        "unit": "none"
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(ipmi_dcmi_power_consumption_watts[$__range])) * $scrape_s / 3600 / 1000 * $carbon",
          "instant": true,
          "legendFormat": "kgCO₂",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "PSU 平均效率",
      "description": "每台机器 ΣPout / ΣPin 后取平均。只有同时上报输入和输出功率的机型才算得出。低于 80% 说明电源转换损耗偏高。",
      "datasource": null,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
