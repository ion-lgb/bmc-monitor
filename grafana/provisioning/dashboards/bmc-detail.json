    {
      "type": "stat",
      "title": "电源状态",
      "description": "关机时 BMC 依然在线,但 CPU/GPU/风扇等传感器会整体消失,下面的图表变空是正常的。",
      "datasource": null,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "无数据",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "已关机",
                  "color": "#8e8e8e",
                  "index": 1
                },
                "1": {
                  "text": "运行中",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ipmi_chassis_power_state{instance=\"$instance\"}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
