# 复制为 .env 后修改。这个文件不会被提交(见 .gitignore)。
# Grafana 管理员密码,首次启动时生效。
# 生成一个随机密码:  openssl rand -base64 18 | tr -d '=+/' | head -c 20
GRAFANA_ADMIN_PASSWORD=change-me-please

# Grafana 对外访问地址(务必改成这台机器在网络里的真实地址,不要留 localhost)。
# 分享链接和页面跳转都以它为准;填错会导致别人打开是空白或加载很慢。
GRAFANA_ROOT_URL=http://192.168.1.10:3000/

# ESXi SNMP 采集(可选,用 Telegraf)。SNMP v3 用户需先在 ESXi 上创建:
#   python telegraf/setup_snmp.py   (见 README「ESXi 监控」一节)
ESXI_HOST=192.168.1.5
SNMP_USER=telegraf
SNMP_AUTH_PASS=change-me-at-least-8-chars
SNMP_PRIV_PASS=change-me-at-least-8-chars

# 告警通知(可选)。留空 = 不推送,告警只进入 Alertmanager(9093 可查)。
# 二选一或都填:
#   - 钉钉:群 -> 设置 -> 机器人 -> 自定义,勾选「加签」并复制 Webhook 地址和密钥;
#   - 企业微信:群 -> 右上角 -> 群机器人 -> 添加,复制 Webhook 地址,
#     建议勾选「自定义关键词」并把关键词设为「告警」。
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
WECHAT_WEBHOOK=
