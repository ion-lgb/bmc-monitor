# 复制为 .env 后修改。这个文件不会被提交(见 .gitignore)。
# Grafana 管理员密码,首次启动时生效。
# 生成一个随机密码:  openssl rand -base64 18 | tr -d '=+/' | head -c 20
GRAFANA_ADMIN_PASSWORD=change-me-please

# Grafana 对外访问地址(务必改成这台机器在网络里的真实地址,不要留 localhost)。
# 分享链接和页面跳转都以它为准;填错会导致别人打开是空白或加载很慢。
GRAFANA_ROOT_URL=http://192.168.1.10:3000/
